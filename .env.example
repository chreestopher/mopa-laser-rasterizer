# Absolute path of this checked-out repository on the Kubernetes/EC2 node.
# Kubernetes bind-mounts this directory directly into the container at /app.
HOST_APP_PATH=/home/ubuntu/mopa-laser-rasterizer

# Optional Redis settings used by ECS/ElastiCache deployments. The existing
# REDIS_HOST=localhost and REDIS_PORT=6379 defaults remain unchanged.
REDIS_SSL=false
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_URL=rediss://user:password@redis.example.cache.amazonaws.com:6379/0

# AWS standard queue used to launch one Fargate task per raster task ID.
SQS_QUEUE_NAME=mopa-laser-raster-jobs
# SQS_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/123456789012/mopa-laser-raster-jobs
# SQS_QUEUE_ARN=arn:aws:sqs:us-east-2:123456789012:mopa-laser-raster-jobs
# SQS_DLQ_URL=https://sqs.us-east-2.amazonaws.com/123456789012/mopa-laser-raster-jobs-dlq
# SQS_DLQ_ARN=arn:aws:sqs:us-east-2:123456789012:mopa-laser-raster-jobs-dlq
FARGATE_DISPATCH_VIA_S3=false
