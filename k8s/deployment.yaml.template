apiVersion: apps/v1
kind: Deployment
metadata:
  name: mopa-laser-rasterizer
  namespace: default
  labels:
    app: mopa-laser-rasterizer
    version: v1
spec:
  replicas: 3
  selector:
    matchLabels:
      app: mopa-laser-rasterizer
  template:
    metadata:
      labels:
        app: mopa-laser-rasterizer
    spec:
      # hostPath is local to one Kubernetes node. Label the node containing the
      # repository with: mopa-laser-rasterizer-host=true.
      nodeSelector:
        mopa-laser-rasterizer-host: "true"
      containers:
      - name: mopa-laser-rasterizer
        image: mopa-laser-rasterizer:local
        imagePullPolicy: IfNotPresent
        # Send worker print()/stderr output to the container log stream.
        command: ["gunicorn"]
        args: ["--workers=1", "--threads=4", "--timeout=1200", "--bind", "0.0.0.0:8000", "--error-logfile=-", "--capture-output", "app:app"]
        ports:
        - name: http
          containerPort: 8000
          protocol: TCP
        resources:
          requests:
            memory: "64Mi"
            cpu: "100m"
          limits:
            memory: "2048Mi"
            cpu: "500m"
#        livenessProbe:
#          httpGet:
#            path: /
#            port: http
#          initialDelaySeconds: 10
#          periodSeconds: 6
#          timeoutSeconds: 60
#          failureThreshold: 3
#        readinessProbe:
#          httpGet:
#            path: /
#            port: http
#          initialDelaySeconds: 5
#          periodSeconds: 6
#          timeoutSeconds: 60
#          failureThreshold: 150
        volumeMounts:
        - name: application-source
          mountPath: /app
          readOnly: false

      volumes:
      # Bind mount the checked-out repository from the selected EC2 node.
      - name: application-source
        hostPath:
          path: ${HOST_APP_PATH}
          type: Directory
