apiVersion: apps/v1
kind: Deployment
metadata:
  name: mopa-laser-rasterizer
  namespace: default
  labels:
    app: mopa-laser-rasterizer
    version: v1
spec:
  replicas: 3
  selector:
    matchLabels:
      app: mopa-laser-rasterizer
  template:
    metadata:
      labels:
        app: mopa-laser-rasterizer
    spec:
      initContainers:
      - name: wait-for-redis
        image: alpine:latest
        command: ["sh", "-c", "until nc -zvw1 redis-service 6379; do echo waiting for redis; sleep 2; done;"]
      containers:
      - name: mopa-laser-rasterizer
        image: mopa-laser-rasterizer:local
        imagePullPolicy: IfNotPresent
        # Send worker print()/stderr output to the container log stream.
        command: ["gunicorn"]
        args: ["--workers=1", "--threads=4", "--timeout=1200", "--bind", "0.0.0.0:8000", "--error-logfile=-", "--capture-output", "app:app"]
        env:
        - name: REDIS_HOST
          value: "redis-service"
        - name: REDIS_PORT
          value: "6379"
        ports:
        - name: http
          containerPort: 8000
          protocol: TCP
        resources:
          requests:
            memory: "256Mi"
            cpu: "100m"
          limits:
            memory: "4096Mi"
            cpu: "500m"
        volumeMounts:
        # The WSL project checkout is bind-mounted over the image's /app.
        - name: application-source
          mountPath: /app
          readOnly: false
      volumes:
      - name: application-source
        hostPath:
          path: __PROJECT_ROOT__
          type: Directory
