# Copy this file to .env.aws and fill in the production-specific identifiers.
# .env.aws is ignored by Git and excluded from Docker build contexts.
AWS_REGION=us-east-2
DEPLOY_AWS_PROFILE=mopa-admin
AWS_ACCOUNT_ID=123456789012
AWS_SSO_START_URL=https://d-example.awsapps.com/start
GITHUB_REPOSITORY_URL=https://github.com/example/mopa-laser-rasterizer.git

IDENTITY_CENTER_ADMIN_EMAIL=admin@example.com
IDENTITY_CENTER_ADMIN_USERNAME=admin
IDENTITY_CENTER_ADMIN_GIVEN_NAME=AWS
IDENTITY_CENTER_ADMIN_FAMILY_NAME=Administrator

K3S_INSTANCE_ID=i-0123456789abcdef0
K3S_PRIVATE_WORKER_INSTANCE_IDS=i-0123456789abcdef1
K3S_SSH_KEY=/path/to/private-key.pem
REDIS_SECURITY_GROUP_ID=sg-0123456789abcdef0

S3_BUCKET_NAME=mopa-laser-rasterizer-artifacts-123456789012
DYNAMODB_TABLE_NAME=mopa-laser-rasterizer-users
COGNITO_POOL_ID=us-east-2_EXAMPLE
COGNITO_CLIENT_ID=examplepublicclientid
COGNITO_DOMAIN=example.auth.us-east-2.amazoncognito.com

# Recorded for operators and DR documentation; CloudFormation outputs remain
# authoritative after infrastructure recreation.
FARGATE_WORKER_SECURITY_GROUP_ID=sg-0123456789abcdef1
