# Copy this file to .env.aws and fill in the production-specific identifiers.
# .env.aws is ignored by Git and excluded from Docker build contexts.
AWS_REGION=us-east-2
DEPLOY_AWS_PROFILE=mopa-admin
AWS_ACCOUNT_ID=123456789012
AWS_SSO_START_URL=https://d-example.awsapps.com/start
GITHUB_REPOSITORY_URL=https://github.com/example/mopa-laser-rasterizer.git

IDENTITY_CENTER_ADMIN_EMAIL=admin@example.com
IDENTITY_CENTER_ADMIN_USERNAME=admin
IDENTITY_CENTER_ADMIN_GIVEN_NAME=AWS
IDENTITY_CENTER_ADMIN_FAMILY_NAME=Administrator

K3S_INSTANCE_ID=i-0123456789abcdef0
K3S_PRIVATE_WORKER_INSTANCE_IDS=i-0123456789abcdef1
K3S_SSH_KEY=/path/to/private-key.pem
# Security group attached to the EC2/ElastiCache host running Redis. Do not use
# the Fargate worker security group; CloudFormation grants that group access.
REDIS_SECURITY_GROUP_ID=sg-0123456789abcdef0

S3_BUCKET_NAME=mopa-laser-rasterizer-artifacts-123456789012
DYNAMODB_TABLE_NAME=mopa-laser-rasterizer-users
COGNITO_POOL_ID=us-east-2_EXAMPLE
COGNITO_CLIENT_ID=examplepublicclientid
COGNITO_DOMAIN=example.auth.us-east-2.amazoncognito.com

# Recorded for operators and DR documentation; CloudFormation outputs remain
# authoritative after infrastructure recreation.
FARGATE_WORKER_SECURITY_GROUP_ID=sg-0123456789abcdef1

# Optional parallel serverless-staging names. The deploy helper creates these
# separately and never changes production DNS.
SERVERLESS_STAGING_FOUNDATION_STACK=mopa-rasterizer-serverless-staging
SERVERLESS_STAGING_WORKER_STACK=mopa-rasterizer-serverless-staging-worker
SERVERLESS_STAGING_FARGATE_CPU=2048
SERVERLESS_STAGING_FARGATE_MEMORY=4096
SERVERLESS_STAGING_WORKER_PROCESSES=2
SERVERLESS_STAGING_KRASNOW_PROGRESS=true
# Staging-only experiment. Set false and redeploy for an immediate rollback to
# the established synthetic Black canvas and ordered punch-through pipeline.
SERVERLESS_STAGING_SOURCE_BLACK_COMPONENTS=true
SERVERLESS_STAGING_ORCHESTRATION_STACK=mopa-rasterizer-serverless-staging-orchestration
SERVERLESS_STAGING_WEB_STACK=mopa-rasterizer-serverless-staging-web
SERVERLESS_STAGING_HOSTNAME=serverless-staging.example.com

# Serverless production promotion. Production deliberately reuses the existing
# durable production S3/DynamoDB stores while creating an isolated queue,
# worker/orchestration, API, CloudFront distribution, and Cognito app client.
# Use the exact commit and image digest already accepted in staging. A tag is
# not accepted, and the production path never performs a local Docker build.
SERVERLESS_PRODUCTION_RELEASE_COMMIT=0123456789abcdef0123456789abcdef01234567
SERVERLESS_PRODUCTION_IMAGE_URI=123456789012.dkr.ecr.us-east-2.amazonaws.com/mopa-laser-rasterizer@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SERVERLESS_PRODUCTION_FOUNDATION_STACK=mopa-rasterizer-serverless-production
SERVERLESS_PRODUCTION_WORKER_STACK=mopa-rasterizer-serverless-production-worker
SERVERLESS_PRODUCTION_ORCHESTRATION_STACK=mopa-rasterizer-serverless-production-orchestration
SERVERLESS_PRODUCTION_WEB_STACK=mopa-rasterizer-serverless-production-web
SERVERLESS_PRODUCTION_HOSTNAME=example.com
SERVERLESS_PRODUCTION_ALTERNATE_HOSTNAME=www.example.com
# Optional during the CloudFront-hostname rehearsal. Required before attaching
# the production hostnames; the certificate must be issued in us-east-1.
SERVERLESS_PRODUCTION_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/example
SERVERLESS_PRODUCTION_FARGATE_CPU=2048
SERVERLESS_PRODUCTION_FARGATE_MEMORY=4096
SERVERLESS_PRODUCTION_WORKER_PROCESSES=1
SERVERLESS_PRODUCTION_SOURCE_BLACK_COMPONENTS=true

# Proton Mail custom-domain DNS. Verification and DKIM values are public DNS
# identifiers, not passwords, but keeping environment-specific values here
# makes the setup helper reusable for disaster recovery.
PROTON_MAIL_DOMAIN=example.com
PROTON_MAIL_HOSTED_ZONE_ID=Z0123456789EXAMPLE
PROTON_MAIL_VERIFICATION=protonmail-verification=example
PROTON_MAIL_DKIM_1=protonmail1.domainkey.example.domains.proton.ch
PROTON_MAIL_DKIM_2=protonmail2.domainkey.example.domains.proton.ch
PROTON_MAIL_DKIM_3=protonmail3.domainkey.example.domains.proton.ch
PROTON_MAIL_DMARC_POLICY=none
